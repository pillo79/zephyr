mainmenu "Snippet tests"

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

# Snippet test types used by the test implementation to steer the test logic
choice
	prompt "Snippet Test Type"
	default TEST_TYPE_NONE

config TEST_TYPE_NONE
	bool "Test Type: None"
	help
	  Test the initial state with no snippets applied.

config TEST_TYPE_FOO
	bool "Test Type: Foo"
	help
	  Test the `foo` snippet from the default application snippet root.

config TEST_TYPE_BAR
	bool "Test Type: Bar"
	help
	  Test the `bar` snippet from an extra snippet root.

config TEST_TYPE_FOO_BAR
	bool "Test Type: Foo-Bar"
	help
	  Test the snippet processing order (1. foo, 2. bar)

config TEST_TYPE_BAR_FOO
	bool "Test Type: Bar-Foo"
	help
	  Test the snippet processing order (1. bar, 2. foo)

config TEST_TYPE_VER_CHECK
	bool "Test Type: Version check"
	help
	  Test board version snippet application

config TEST_TYPE_VER_CHECK_SPECIFIC
	bool "Test Type: Version check specific"
	help
	  Test board version snippet application with specific board version

config TEST_TYPE_VER_CHECK_SPECIFIC_SHIELD
	bool "Test Type: Version check specific with shield"
	help
	  Test board version snippet application with a specific board version
	  and a shield

config TEST_TYPE_FILE_LIST
	bool "Test Type: File list"
	help
	  Test list support for snippet conf and overlay files.

endchoice

# Test values set by the snippet config overlays and tested by the test logic
config TEST_FOO_VAL
	int "Test value set by the 'foo' snippet config overlay"
	help
	  This option's value should be overridden by the 'foo' snippet config
	  overlay.

config TEST_BAR_VAL
	int "Test value set by the 'bar' snippet config overlay"
	help
	  This option's value should be overridden by the 'bar' snippet config
	  overlay.

config TEST_COMMON_VAL
	int "Test value set by the snippet config overlays"
	help
	  This option's value should be overridden by the snippet config
	  overlays.

# Set by the 'shield_check' snippet, to test shield-specific snippet settings
config TEST_SHIELD_COMMON_APPLIED
	bool "Test shield check snippet applied"
	help
	  Set by the common part of the 'shield_check' snippet.

config TEST_SHIELD_ONE_APPLIED
	bool "Test shield-specific snippet applied"
	help
	  Set by the 'shield_check' snippet section for shield
	  'snippet_shield_one'.

config TEST_SHIELD_REGEX_APPLIED
	bool "Test shield regular expression snippet applied"
	help
	  Set by the 'shield_check' snippet section matching all the
	  'snippet_shield_*' shields.

config TEST_SHIELD_NEVER_APPLIED
	bool "Test snippet section for a shield which is never used"
	help
	  Set by the 'shield_check' snippet section for a shield which does not
	  exist, and must therefore never end up in the build.

# Set by the 'board_shield_check' snippet, to test shield sections nested
# inside a board section
config TEST_BOARD_SHIELD_COMMON_APPLIED
	bool "Test board section of the board_shield_check snippet applied"

config TEST_BOARD_SHIELD_ONE_APPLIED
	bool "Test board + 'snippet_shield_one' section applied"

config TEST_BOARD_SHIELD_REGEX_APPLIED
	bool "Test board + shield regular expression section applied"

config TEST_BOARD_ONLY_SHIELD_TWO_APPLIED
	bool "Test section of a board which only has a nested shield applied"

# Set by the snippet section which is expected to win when a board section and
# a shield section both set it
config TEST_PRECEDENCE_VAL
	int "Test value set by several competing snippet sections"
	default 0

# Set from tests.yaml, to tell the test which sections it should see
config TEST_EXPECT_PRECEDENCE_VAL
	int "Expected value of TEST_PRECEDENCE_VAL"
	default 0

config TEST_EXPECT_SHIELD_COMMON
	bool "Expect the common 'shield_check' settings"

config TEST_EXPECT_SHIELD_ONE
	bool "Expect the 'snippet_shield_one' settings"

config TEST_EXPECT_SHIELD_REGEX
	bool "Expect the shield regular expression settings"

config TEST_EXPECT_BOARD_SHIELD_COMMON
	bool "Expect the 'board_shield_check' board settings"

config TEST_EXPECT_BOARD_SHIELD_ONE
	bool "Expect the board + 'snippet_shield_one' settings"

config TEST_EXPECT_BOARD_SHIELD_REGEX
	bool "Expect the board + shield regular expression settings"

config TEST_EXPECT_BOARD_ONLY_SHIELD_TWO
	bool "Expect the settings of the board which only has a nested shield"

# Used for testing board version snippets
config TEST_VER_CHECK_APPLIED
	bool "Test version check snippet applied"
	help
	  This option's value should be set by the ver_check snippet.

config TEST_VER_CHECK_SPECIFIC_VERSION_APPLIED
	bool "Test version check with board version snippet applied"
	help
	  This option's value should be set by the ver_check snippet.

config TEST_VER_CHECK_SPECIFIC_SHIELD_APPLIED
	bool "Test version check with board version and shield snippet applied"
	help
	  This option's value should be set by the ver_check snippet section for
	  a shield nested inside a board revision.

# Used for testing board file list variables
config TEST_BOARD1
	bool "Test value set by the snippet file list board 1 config overlay"
	help
	  This option's value should be overridden by the snippet config
	  overlays.

config TEST_BOARD2
	bool "Test value set by the snippet file list board 2 config overlay"
	help
	  This option's value should be overridden by the snippet config
	  overlays.
